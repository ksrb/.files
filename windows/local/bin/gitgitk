#!/usr/bin/env bash

# Use with:
# $HOME/.gitconfig_local
# [alias]
#   gui = "!bash \"gitgitk\""
#
# Allowing WSL terminal's 'gitk' command to open window's gitk.exe

# CYGWIN
if [[ "$(uname)" == "CYGWIN"* ]]; then
  "C:/Program Files/Git/cmd/gitk.exe"
# WSL
elif [[ -n "$WSL_DISTRO_NAME" ]]; then
  "/mnt/c/Program Files/Git/cmd/gitk.exe"
fi
